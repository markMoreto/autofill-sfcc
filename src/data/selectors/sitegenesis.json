{
  "$comment": "SiteGenesis (app_storefront_core) selector map. SG generates ids with random suffixes, so everything matches on the stable dwfrm_* name attribute via suffix matching — cartridges that rename the top-level prefix still hit.",
  "platform": "sitegenesis",
  "fields": {
    "email": ["input[name$=\"_profile_customer_email\"]"],
    "emailConfirm": ["input[name$=\"_profile_customer_emailconfirm\"]"],
    "loginEmail": ["input[name$=\"_login_username\"]"],
    "loginPassword": ["input[name=\"dwfrm_login_password\"]", "input[name$=\"_login_password\"]:not([name*=\"profile\"])"],
    "password": ["input[name$=\"_profile_login_password\"]"],
    "passwordConfirm": ["input[name$=\"_profile_login_passwordconfirm\"]"],
    "firstName": ["input[name$=\"_profile_customer_firstname\"]"],
    "lastName": ["input[name$=\"_profile_customer_lastname\"]"],
    "phone": ["input[name$=\"_profile_customer_phone\"]", "input[name$=\"_profile_customer_phoneMobile\"]"],
    "guestEmail": ["input[name$=\"_singleshipping_shippingAddress_email_emailAddress\"]"],
    "address.addressId": ["input[name$=\"_profile_address_addressid\"]"],
    "address.firstName": ["input[name$=\"_profile_address_firstname\"]"],
    "address.lastName": ["input[name$=\"_profile_address_lastname\"]"],
    "address.address1": ["input[name$=\"_profile_address_address1\"]"],
    "address.address2": ["input[name$=\"_profile_address_address2\"]"],
    "address.country": ["select[name$=\"_profile_address_country\"]"],
    "address.state": ["select[name$=\"_profile_address_states_state\"]", "input[name$=\"_profile_address_states_state\"]"],
    "address.city": ["input[name$=\"_profile_address_city\"]"],
    "address.postalCode": ["input[name$=\"_profile_address_postal\"]"],
    "address.phone": ["input[name$=\"_profile_address_phone\"]"],
    "shipping.firstName": ["input[name$=\"shippingAddress_addressFields_firstName\"]"],
    "shipping.lastName": ["input[name$=\"shippingAddress_addressFields_lastName\"]"],
    "shipping.address1": ["input[name$=\"shippingAddress_addressFields_address1\"]"],
    "shipping.address2": ["input[name$=\"shippingAddress_addressFields_address2\"]"],
    "shipping.country": ["select[name$=\"shippingAddress_addressFields_country\"]"],
    "shipping.state": ["select[name$=\"shippingAddress_addressFields_states_state\"]", "input[name$=\"shippingAddress_addressFields_states_state\"]"],
    "shipping.city": ["input[name$=\"shippingAddress_addressFields_city\"]"],
    "shipping.postalCode": ["input[name$=\"shippingAddress_addressFields_postal\"]", "input[name$=\"shippingAddress_addressFields_zip\"]"],
    "shipping.phone": ["input[name$=\"shippingAddress_addressFields_phone\"]"],
    "billing.firstName": ["input[name$=\"billing_billingAddress_addressFields_firstName\"]"],
    "billing.lastName": ["input[name$=\"billing_billingAddress_addressFields_lastName\"]"],
    "billing.address1": ["input[name$=\"billing_billingAddress_addressFields_address1\"]"],
    "billing.address2": ["input[name$=\"billing_billingAddress_addressFields_address2\"]"],
    "billing.country": ["select[name$=\"billing_billingAddress_addressFields_country\"]"],
    "billing.state": ["select[name$=\"billing_billingAddress_addressFields_states_state\"]", "input[name$=\"billing_billingAddress_addressFields_states_state\"]"],
    "billing.city": ["input[name$=\"billing_billingAddress_addressFields_city\"]"],
    "billing.postalCode": ["input[name$=\"billing_billingAddress_addressFields_postal\"]", "input[name$=\"billing_billingAddress_addressFields_zip\"]"],
    "billing.phone": ["input[name$=\"billing_billingAddress_addressFields_phone\"]"],
    "billing.email": ["input[name$=\"billing_billingAddress_email_emailAddress\"]"],
    "billing.sameAsShipping": ["input[name$=\"_shippingAddress_useAsBillingAddress\"]"],
    "card.holder": ["input[name$=\"creditCard_owner\"]", "input[name$=\"_paymentinstruments_creditcards_newcreditcard_owner\"]"],
    "card.number": ["input[name$=\"creditCard_number\"]", "input[name$=\"_newcreditcard_number\"]"],
    "card.expMonth": ["select[name$=\"creditCard_expiration_month\"]", "select[name$=\"_newcreditcard_expiration_month\"]"],
    "card.expYear": ["select[name$=\"creditCard_expiration_year\"]", "select[name$=\"_newcreditcard_expiration_year\"]"],
    "card.cvv": ["input[name$=\"creditCard_cvn\"]"],
    "card.type": ["select[name$=\"creditCard_type\"]", "input[name$=\"creditCard_type\"]", "select[name$=\"_newcreditcard_type\"]"],
    "guestCheckout": ["button[name$=\"_login_unregistered\"]"],
    "account.setDefault": ["input[name$=\"_profile_address_makeDefault\"]"],
    "newsletter": ["input[name$=\"_profile_customer_addtoemaillist\"]"]
  },
  "reveals": {
    "guest": ["button[name$=\"_login_unregistered\"]"]
  }
}
