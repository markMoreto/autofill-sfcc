{
  "$comment": "PWA Kit (Retail React App) selector map. React-controlled inputs — fill.js always uses the native value setter so React's tracked value updates. Prefer stable `name` attributes over data-testids (testids churn between template versions).",
  "platform": "pwakit",
  "fields": {
    "email": ["form[data-testid=\"sf-auth-modal-form-register\"] input[name=\"email\"]", "[data-testid=\"sf-register-form\"] input[name=\"email\"]", "input[name=\"email\"]"],
    "loginEmail": ["form[data-testid=\"sf-auth-modal-form\"] input[name=\"email\"]", "[data-testid=\"sf-login-form\"] input[name=\"email\"]"],
    "loginPassword": ["form[data-testid=\"sf-auth-modal-form\"] input[name=\"password\"]", "[data-testid=\"sf-login-form\"] input[name=\"password\"]"],
    "password": ["input[name=\"password\"]"],
    "firstName": ["input[name=\"firstName\"]"],
    "lastName": ["input[name=\"lastName\"]"],
    "phone": ["input[name=\"phone\"]"],
    "shipping.firstName": ["[data-testid=\"sf-checkout-shipping-address-form\"] input[name=\"firstName\"]", "[data-testid*=\"shipping\"] input[name=\"firstName\"]"],
    "shipping.lastName": ["[data-testid=\"sf-checkout-shipping-address-form\"] input[name=\"lastName\"]", "[data-testid*=\"shipping\"] input[name=\"lastName\"]"],
    "shipping.address1": ["[data-testid=\"sf-checkout-shipping-address-form\"] input[name=\"address1\"]", "[data-testid*=\"shipping\"] input[name=\"address1\"]", "input[name=\"address1\"]"],
    "shipping.address2": ["[data-testid*=\"shipping\"] input[name=\"address2\"]", "input[name=\"address2\"]"],
    "shipping.country": ["[data-testid*=\"shipping\"] select[name=\"countryCode\"]", "select[name=\"countryCode\"]"],
    "shipping.state": ["[data-testid*=\"shipping\"] select[name=\"stateCode\"]", "select[name=\"stateCode\"]", "input[name=\"stateCode\"]"],
    "shipping.city": ["[data-testid*=\"shipping\"] input[name=\"city\"]", "input[name=\"city\"]"],
    "shipping.postalCode": ["[data-testid*=\"shipping\"] input[name=\"postalCode\"]", "input[name=\"postalCode\"]"],
    "shipping.phone": ["[data-testid*=\"shipping\"] input[name=\"phone\"]"],
    "billing.firstName": ["[data-testid*=\"billing\"] input[name=\"firstName\"]"],
    "billing.lastName": ["[data-testid*=\"billing\"] input[name=\"lastName\"]"],
    "billing.address1": ["[data-testid*=\"billing\"] input[name=\"address1\"]"],
    "billing.address2": ["[data-testid*=\"billing\"] input[name=\"address2\"]"],
    "billing.country": ["[data-testid*=\"billing\"] select[name=\"countryCode\"]"],
    "billing.state": ["[data-testid*=\"billing\"] select[name=\"stateCode\"]", "[data-testid*=\"billing\"] input[name=\"stateCode\"]"],
    "billing.city": ["[data-testid*=\"billing\"] input[name=\"city\"]"],
    "billing.postalCode": ["[data-testid*=\"billing\"] input[name=\"postalCode\"]"],
    "billing.phone": ["[data-testid*=\"billing\"] input[name=\"phone\"]"],
    "billing.sameAsShipping": ["input[name=\"billingSameAsShipping\"]", "[data-testid*=\"billing\"] input[type=\"checkbox\"]"],
    "card.holder": ["input[name=\"holder\"]"],
    "card.number": ["input[name=\"number\"]"],
    "card.expiry": ["input[name=\"expiry\"]"],
    "card.cvv": ["input[name=\"securityCode\"]", "input[name=\"cvv\"]"]
  }
