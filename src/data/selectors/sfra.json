{
  "$comment": "SFRA (app_storefront_base) selector map. Each logical field lists CSS selectors in priority order; the first match that is fillable wins. Multi-shipment pages are handled by the [id^=...] variants plus per-form scoping in detect.js. See docs/MAINTENANCE.md#selector-maps.",
  "platform": "sfra",
  "fields": {
    "email": ["#registration-form-email", "#email-guest", "input[name$=\"_email_emailAddress\"]", "input[name$=\"_customer_email\"]"],
    "emailConfirm": ["#registration-form-email-confirm"],
    "loginEmail": ["#login-form-email", "input[name$=\"_login_email\"]"],
    "loginPassword": ["#login-form-password", "input[name$=\"_login_password\"]"],
    "password": ["#registration-form-password", "input[name$=\"_profile_login_password\"]"],
    "passwordConfirm": ["#registration-form-password-confirm", "input[name$=\"_login_passwordconfirm\"]"],
    "firstName": ["#registration-form-fname", "form.registration input[name$=\"_firstname\"]"],
    "lastName": ["#registration-form-lname", "form.registration input[name$=\"_lastname\"]"],
    "phone": ["#registration-form-phone", "form.registration input[name$=\"_phone\"]"],
    "address.addressId": ["#addressId", "input[name$=\"_addressId\"]"],
    "address.firstName": ["form.address-form #firstName", ".address-form #firstName", "#firstName"],
    "address.lastName": ["form.address-form #lastName", ".address-form #lastName", "#lastName"],
    "address.address1": ["form.address-form #address1", "#address1"],
    "address.address2": ["form.address-form #address2", "#address2"],
    "address.country": ["form.address-form #country", "#country"],
    "address.state": ["form.address-form #state", "#state"],
    "address.city": ["form.address-form #city", "#city"],
    "address.postalCode": ["form.address-form #zipCode", "#zipCode"],
    "address.phone": ["form.address-form #phone", "#phone"],
    "shipping.firstName": ["#shippingFirstName", "input[id^=\"shippingFirstName\"]", "input[name$=\"shippingAddress_addressFields_firstName\"]"],
    "shipping.lastName": ["#shippingLastName", "input[id^=\"shippingLastName\"]", "input[name$=\"shippingAddress_addressFields_lastName\"]"],
    "shipping.address1": ["#shippingAddressOne", "input[id^=\"shippingAddressOne\"]", "input[name$=\"shippingAddress_addressFields_address1\"]"],
    "shipping.address2": ["#shippingAddressTwo", "input[id^=\"shippingAddressTwo\"]", "input[name$=\"shippingAddress_addressFields_address2\"]"],
    "shipping.country": ["#shippingCountry", "select[id^=\"shippingCountry\"]", "select[name$=\"shippingAddress_addressFields_country\"]"],
    "shipping.state": ["#shippingState", "select[id^=\"shippingState\"]", "input[id^=\"shippingState\"]", "select[name$=\"shippingAddress_addressFields_states_stateCode\"]"],
    "shipping.city": ["#shippingAddressCity", "input[id^=\"shippingAddressCity\"]", "input[name$=\"shippingAddress_addressFields_city\"]"],
    "shipping.postalCode": ["#shippingZipCode", "input[id^=\"shippingZipCode\"]", "input[name$=\"shippingAddress_addressFields_postalCode\"]"],
    "shipping.phone": ["#shippingPhoneNumber", "input[id^=\"shippingPhoneNumber\"]", "input[name$=\"shippingAddress_addressFields_phone\"]"],
    "billing.firstName": ["#billingFirstName", "input[name$=\"billing_addressFields_firstName\"]"],
    "billing.lastName": ["#billingLastName", "input[name$=\"billing_addressFields_lastName\"]"],
    "billing.address1": ["#billingAddressOne", "input[name$=\"billing_addressFields_address1\"]"],
    "billing.address2": ["#billingAddressTwo", "input[name$=\"billing_addressFields_address2\"]"],
    "billing.country": ["#billingCountry", "select[name$=\"billing_addressFields_country\"]"],
    "billing.state": ["#billingState", "select[name$=\"billing_addressFields_states_stateCode\"]"],
    "billing.city": ["#billingAddressCity", "input[name$=\"billing_addressFields_city\"]"],
    "billing.postalCode": ["#billingZipCode", "input[name$=\"billing_addressFields_postalCode\"]"],
    "billing.phone": [".payment-form #phoneNumber", "#phoneNumber", "input[name$=\"billing_contactInfoFields_phone\"]"],
    "billing.email": [".payment-form #email", "input[name$=\"billing_contactInfoFields_email\"]"],
    "billing.sameAsShipping": ["#shippingAsBilling", "input[name$=\"_shippingAddressUseAsBillingAddress\"]"],
    "card.holder": ["#cardOwner", "input[name$=\"_cardOwner\"]", "input[name$=\"creditCard_owner\"]"],
    "card.number": ["#cardNumber", "input[name$=\"_cardNumber\"]"],
    "card.expMonth": ["#expirationMonth", "select[name$=\"_expirationMonth\"]"],
    "card.expYear": ["#expirationYear", "select[name$=\"_expirationYear\"]"],
    "card.cvv": ["#securityCode", "input[name$=\"_securityCode\"]"],
    "card.type": ["#cardType", "input[name$=\"_cardType\"]"],
    "account.setDefault": ["#setDefaultAddress", "input[name$=\"_setAsDefault\"]"],
    "terms": ["#add-to-email-list-register", "input[name$=\"_addtoemaillist\"]"]
  },
  "reveals": {
    "$comment": "Selectors clicked to expand a collapsed section before filling its fields. Key = logical scope.",
    "billing": [".billing-address-block .btn-show-details", ".address-selector-block .btn-show-details", ".payment-form .btn-show-details", ".billing-address-block .btn-edit"],
    "guest": [".checkout-as-guest", "a[href*=\"Checkout-Guest\"]"]
  },
  "shipmentForms": ".shipping-form, form.shipping-form, [data-shipment-uuid]"
}
